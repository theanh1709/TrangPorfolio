{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trangporfolio",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-db",
      "database_id": "6e4f808d-6628-4af8-b105-09ea322c32b5",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://trangporfolio.vu-theanh1709.workers.dev"
  }
}
