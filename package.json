{
  "name": "trangporfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "typegen": "wrangler types && react-router typegen",
    "typecheck": "wrangler types && react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply portfolio-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply portfolio-db --remote",
    "db:seed:local": "wrangler d1 execute portfolio-db --local --file=drizzle/seed/seed.sql",
    "db:seed:prod": "wrangler d1 execute portfolio-db --remote --file=drizzle/seed/seed.sql",
    "assets:prepare": "tsx scripts/prepare-assets.ts",
    "assets:upload": "tsx scripts/upload-media.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/poppins": "5.2.6",
    "@fontsource/roboto": "5.2.6",
    "clsx": "2.1.1",
    "drizzle-orm": "0.44.5",
    "isbot": "5.1.30",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router": "7.9.1",
    "tailwind-merge": "3.3.1",
    "tailwind-variants": "1.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@cloudflare/vite-plugin": "1.13.5",
    "@cloudflare/workers-types": "4.20250920.0",
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.55.0",
    "@react-router/dev": "7.9.1",
    "@tailwindcss/vite": "4.1.13",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "drizzle-kit": "0.31.4",
    "eslint": "9.35.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "26.1.0",
    "sharp": "0.34.4",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0",
    "vite": "6.3.6",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4",
    "wrangler": "4.38.0"
  }
}
